# ============================================================
#  SAR-Drishti Backend — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env, gee_key.json, or data/ to git.
# ============================================================

# ── PostgreSQL / PostGIS ────────────────────────────────────
POSTGRES_HOST=postgis
POSTGRES_PORT=5432
POSTGRES_DB=sardrishti
POSTGRES_USER=sardrishti
POSTGRES_PASSWORD=changeme_in_production

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── MinIO (S3-compatible object store) ─────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secret
MINIO_BUCKET=sardrishti
MINIO_SECURE=false

# ── Google Earth Engine ─────────────────────────────────────
# Leave blank to run in DEMO_MODE (synthetic rasters).
# GEE_KEY_FILE path is relative to the container working dir.
GEE_PROJECT=
GEE_KEY_FILE=

# ── Copernicus Data Space Ecosystem (CDSE) ─────────────────
# Leave blank to run in DEMO_MODE.
CDSE_USERNAME=
CDSE_PASSWORD=

# ── JWT Auth ────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# ── OTP ─────────────────────────────────────────────────────
OTP_TTL_SEC=300
OTP_RATE_LIMIT_COUNT=3
OTP_RATE_LIMIT_WINDOW_MIN=10
OTP_MAX_VERIFY_ATTEMPTS=5

# ── Notification Gateways (sandbox/console in dev) ──────────
# Set to "console" in dev — OTPs and SMS are printed to logs.
SMS_GATEWAY=console
WHATSAPP_GATEWAY=console
SANDES_GATEWAY=console

# ── Pipeline mode ───────────────────────────────────────────
# DEMO_MODE=true  → synthetic rasters, no GEE/CDSE calls.
# DEMO_MODE=false → real pipeline (requires GEE + CDSE above).
DEMO_MODE=true

# ── Tile Services (internal Docker network) ─────────────────
MARTIN_URL=http://martin:3000
TITILER_URL=http://titiler:8080

# ── Celery ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Frontend (Vite) ─────────────────────────────────────────
# Used by the React app, not this backend. Listed here for reference.
# VITE_API_URL=http://localhost:8000

# ── SAR pipeline thresholds (editable via Admin UI) ─────────
OTSU_SLOPE_MAX_DEG=5.0
OTSU_HAND_MAX_M=15.0
MIN_FLOOD_AREA_HA=1.0
JRC_OCCURRENCE_THRESHOLD=75
CONFIDENCE_UNET_WEIGHT=0.0

